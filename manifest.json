{
  "manifest_version": 3,
  "name": "Lazy Reverb",
  "version": "0.3.0",
  "description": "Slowed playback, reverb, and bass boost for YouTube and SoundCloud in Zen Browser and Firefox. Audio is processed on your device.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://*.youtube.com/*", "https://soundcloud.com/*", "https://www.soundcloud.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "lazy-reverb@local.example",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "action": { "default_title": "Lazy Reverb", "default_popup": "popup.html", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+F8" },
      "description": "Open Lazy Reverb"
    }
  },
  "content_scripts": [{
    "matches": ["https://*.youtube.com/*", "https://soundcloud.com/*", "https://www.soundcloud.com/*"],
    "js": ["engine.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }]
}
