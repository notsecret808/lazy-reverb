{
  "name": "lazy-reverb",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "prepare": "node --import tsx tools/prepare-hooks.ts",
    "check:commit": "node --import tsx tools/check-commit.ts && pnpm run lint && pnpm run typecheck && pnpm run test:unit && python3 -m unittest discover -s tests -p test_performance_gate.py",
    "lint:commit": "commitlint",
    "lint": "oxlint --type-aware --deny-warnings src tools *.config.ts",
    "typecheck": "tsc -p src/tsconfig.json && tsc -p tsconfig.json",
    "package": "python3 tools/package.py",
    "test": "playwright test",
    "test:unit": "node --expose-gc --test tests/engine.test.cjs tests/popup.test.cjs",
    "check": "pnpm run lint && pnpm run typecheck && python3 tools/test.py",
    "check:perf": "python3 tools/performance.py --browser /opt/zen/zen"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "^1.65.1",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "husky": "^9.1.7",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "webdriverio": "10.2.0"
  }
}
