{
  "name": "lazy-reverb",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "prepare": "node --import tsx tools/prepare-hooks.ts",
    "check:commit": "node --import tsx tools/check-commit.ts && pnpm run lint && pnpm run typecheck && pnpm run test:unit && python3 -m unittest discover -s tests -p test_performance_gate.py",
    "lint:commit": "commitlint",
    "lint": "oxlint --type-aware --deny-warnings src tools tests/native tests/*.test.ts *.config.ts",
    "typecheck": "tsc -p src/tsconfig.json && tsc -p tsconfig.json",
    "build": "node --import tsx tools/build.ts",
    "package": "node --import tsx tools/package.ts",
    "test": "pnpm run build && playwright test",
    "test:native": "node --import tsx --test --test-concurrency=1 tests/native/*.test.ts",
    "test:unit": "pnpm run build && node --expose-gc --import tsx --test tests/*.test.ts",
    "check": "pnpm run lint && pnpm run typecheck && python3 tools/test.py",
    "check:perf": "node --import tsx tools/performance.ts",
    "live:probe": "node --import tsx tools/live-probe.ts",
    "live:control": "node --import tsx tools/live-control.ts",
    "live:perf": "node --import tsx tools/live-performance.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "^1.65.1",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "husky": "^9.1.7",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "webdriverio": "10.2.0"
  }
}
